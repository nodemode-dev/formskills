#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

cli() {
  bin=target/release/formskills-cli
  if [ ! -x "$bin" ] || [ -n "$(find cli core Cargo.toml -newer "$bin" \( -name '*.rs' -o -name '*.toml' -o -name '*.json' \) 2>/dev/null | head -1)" ]; then
    command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs. Then run ./formskills_oc_install" >&2; exit 1; }
    cargo build -q --release --locked -p formskills-cli >&2
  fi
  exec "$bin" "$@"
}

dev() {
  export FORMSKILLS_DEV=1
  export FORMSKILLS_DEV_ROOTS="${FORMSKILLS_DEV_ROOTS-$(cd .. && pwd)}"
}

case "${1:-}" in
  cli) shift; cli "$@" ;;
  apps) shift; exec python3 setup/apps.py "$@" ;;
  dev) shift; dev; [ "${1:-}" = "cli" ] && { shift; cli "$@"; } ;;
esac

command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs. Then run ./formskills_oc_install"; exit 1; }
[ -d frontend/node_modules ] || { echo "Run ./formskills_oc_install first."; exit 1; }

set -m
interface=
stop() {
  trap - EXIT INT TERM
  [ -n "$interface" ] && kill -- "-$interface" 2>/dev/null || true
}
trap stop EXIT INT TERM

( cd frontend && ./boot_frontend ) &
interface=$!

for _ in $(seq 1 100); do
  (exec 3<>/dev/tcp/localhost/5630) 2>/dev/null && break
  sleep 0.2
done

cargo run -p formskills -- "$@"
