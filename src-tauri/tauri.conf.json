{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formskills",
  "version": "0.3.1",
  "identifier": "ai.nodemode.formskills",
  "build": {
    "devUrl": "http://localhost:5630",
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      { "label": "main", "title": "formskills", "width": 1040, "height": 720, "minWidth": 640, "minHeight": 480, "resizable": true, "center": true, "backgroundColor": "#14161b" }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The Form apps' released skills: read, download, keep your own edits",
    "copyright": "Copyright 2026 NodeAgentc, Inc. GPL-3.0-only",
    "license": "GPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
