{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormSkills",
  "version": "0.8.3",
  "identifier": "ai.nodemode.formskills",
  "build": {
    "devUrl": "http://localhost:5630",
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src formext: http://formext.localhost"
    },
    "windows": [
      { "label": "splash", "title": "FormSkills", "url": "splash.html", "width": 360, "height": 200, "resizable": false, "decorations": false, "center": true, "transparent": true, "shadow": false, "visible": false },
      { "label": "main", "title": "FormSkills", "width": 1040, "height": 720, "minWidth": 640, "minHeight": 480, "resizable": true, "center": true, "visible": false, "backgroundColor": "#0a0a0a" }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The Form apps' released skills: read, download, keep your own edits",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. GPL-3.0-only",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
